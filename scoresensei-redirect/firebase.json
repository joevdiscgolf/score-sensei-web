{
  "hosting": {
    "site": "scoresensei-redirect",
    "public": "public",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/ig",
        "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=ig_bio",
        "type": 301
      },
      {
        "source": "/yt",
        "destination": "/?utm_source=youtube&utm_medium=description&utm_campaign=yt_description",
        "type": 301
      },
      {
        "source": "/coacht",
        "destination": "/?utm_source=coacht&utm_medium=partner&utm_campaign=coacht",
        "type": 301
      }
    ]
  }
}
