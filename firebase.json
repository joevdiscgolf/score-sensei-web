{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "app/**",
      "dist/**",
      "deploy.sh",
      "*.md",
      "package.json",
      "vercel.json"
    ],
    "redirects": [
      {
        "source": "/ig",
        "destination": "/?utm_source=instagram&utm_medium=bio&utm_campaign=ig_bio",
        "type": 301
      },
      {
        "source": "/yt",
        "destination": "/?utm_source=youtube&utm_medium=description&utm_campaign=yt_description",
        "type": 301
      },
      {
        "source": "/coacht",
        "destination": "/?utm_source=coacht&utm_medium=partner&utm_campaign=coacht",
        "type": 301
      },
      {
        "source": "/dashboard{,/**}",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/dashboard.html",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|webp|gif|mp4|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      }
    ]
  }
}
